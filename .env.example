# Supabase project (Settings -> API in your Supabase dashboard)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# EmailJS (emailjs.com) - powers the Contact page form
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_TEMPLATE_ID=
VITE_EMAILJS_PUBLIC_KEY=

# Absolute site origin, used to build canonical/OG URLs (no trailing slash)
VITE_SITE_URL=https://example.com

# Google Tag Manager container ID (Admin -> Container Settings). Leave blank
# or as the placeholder below to skip loading GTM entirely.
VITE_GTM_ID=GTM-XXXXXXX
